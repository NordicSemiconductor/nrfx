                <lsb>16</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Invalid</name>
                    <description>This register is not programmed with valid content. Any other value than the value for valid.</description>
                    <value>0xFFFF</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Valid</name>
                    <description>This register is programmed with valid content.</description>
                    <value>0xAC53</value>
                  </enumeratedValue>
