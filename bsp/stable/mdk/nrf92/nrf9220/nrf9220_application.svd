                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MULT_3</name>
              <description>Indicates whether multiplying the trigger counter by 2^(3+1) is supported.</description>
              <lsb>3</lsb>
              <msb>3</msb>
