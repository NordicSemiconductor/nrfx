    <peripheral>
      <name>BICR_NS</name>
      <description>Board information configuration registers</description>
      <baseAddress>0x0FFF0800</baseAddress>
      <alternatePeripheral>UICR_NS</alternatePeripheral>
      <headerStructName>BICR</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
      <addressBlock>
        <offset>0</offset>
        <size>0x80</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>BICR</groupName>
      <size>0x20</size>
      <registers>
        <cluster>
          <name>POWER</name>
          <description>Unspecified</description>
          <headerStructName>BICR_POWER</headerStructName>
          <access>read-write</access>
          <addressOffset>0x000</addressOffset>
          <register>
            <name>CONFIG</name>
            <description>Power configuration of power rails.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VDDAO1V8</name>
                <description>VDD_AO_1V8 power configuration.</description>
                <lsb>2</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
