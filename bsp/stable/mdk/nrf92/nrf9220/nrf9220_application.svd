                <enumeratedValue>
                  <name>Disabled</name>
                  <description>The trace event does not affect the sequencer.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>When the event occurs then the sequencer state moves from state n to state n+1.</description>
