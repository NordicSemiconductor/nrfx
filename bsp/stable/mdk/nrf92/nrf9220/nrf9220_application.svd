                    <name>NoOverrun</name>
                    <description>No overrun detected</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Overrun</name>
                    <description>Overrun error</description>
                    <value>0x1</value>
                  </enumeratedValue>
