  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <headerDefinitionsPrefix>NRF_</headerDefinitionsPrefix>
  <cpu>
    <name>CM33</name>
    <revision>r1p0</revision>
    <endian>little</endian>
    <mpuPresent>1</mpuPresent>
    <fpuPresent>1</fpuPresent>
    <nvicPrioBits>3</nvicPrioBits>
    <vendorSystickConfig>0</vendorSystickConfig>
    <deviceNumInterrupts>480</deviceNumInterrupts>
    <sauNumRegions>4</sauNumRegions>
  </cpu>
  <headerSystemFilename>system_nrf9220_application</headerSystemFilename>
  <vendorExtensions>
    <MaxInterrupts>480</MaxInterrupts>
  </vendorExtensions>
  <peripherals>
    <peripheral>
      <name>ICACHEDATA_S</name>
      <description>CACHEDATA</description>
      <baseAddress>0x02F00000</baseAddress>
      <headerStructName>ICACHEDATA</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=S-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>ICACHEDATA</groupName>
      <size>0x20</size>
      <registers>
        <cluster>
          <dim>1024</dim>
          <dimIncrement>0x040</dimIncrement>
          <name>SET[%s]</name>
          <description>Unspecified</description>
          <headerStructName>ICACHEDATA_SET</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0</addressOffset>
          <cluster>
            <dim>2</dim>
            <dimIncrement>0x020</dimIncrement>
            <name>WAY[%s]</name>
            <description>Unspecified</description>
            <headerStructName>ICACHEDATA_SET_WAY</headerStructName>
            <access>read-write</access>
            <addressOffset>0x0</addressOffset>
            <cluster>
              <dim>4</dim>
              <dimIncrement>0x008</dimIncrement>
              <name>DU[%s]</name>
              <description>Unspecified</description>
              <headerStructName>ICACHEDATA_SET_WAY_DU</headerStructName>
              <access>read-write</access>
              <addressOffset>0x0</addressOffset>
              <register>
                <dim>0x2</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>DATA[%s]</name>
                <description>Description collection: Cache data bits for DATA[q] in DU[p] (DataUnit) of SET[n], WAY[o].</description>
                <addressOffset>0x0</addressOffset>
                <access>read-write</access>
                <resetValue>0x00000000</resetValue>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>Data</name>
                    <description>Data</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
            </cluster>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>ICACHEINFO_S</name>
      <description>CACHEINFO</description>
      <baseAddress>0x02F10000</baseAddress>
      <headerStructName>ICACHEINFO</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=S-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>ICACHEINFO</groupName>
      <size>0x20</size>
      <registers>
        <cluster>
          <dim>1024</dim>
          <dimIncrement>0x008</dimIncrement>
          <name>SET[%s]</name>
          <description>Unspecified</description>
          <headerStructName>ICACHEINFO_SET</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0</addressOffset>
          <cluster>
            <dim>2</dim>
            <dimIncrement>0x004</dimIncrement>
            <name>WAY[%s]</name>
            <description>Unspecified</description>
            <headerStructName>ICACHEINFO_SET_WAY</headerStructName>
            <access>read-write</access>
            <addressOffset>0x0</addressOffset>
            <register>
              <name>INFO</name>
              <description>Description cluster: Cache information for SET[n], WAY[o].</description>
              <addressOffset>0x0</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>TAG</name>
                  <description>Cache tag.</description>
                  <lsb>0</lsb>
                  <msb>19</msb>
                  <access>read-only</access>
                </field>
                <field>
                  <name>DUV_0</name>
                  <description>Data unit valid info.</description>
                  <lsb>24</lsb>
                  <msb>24</msb>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Invalid</name>
                      <description>Invalid data unit</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Valid</name>
                      <description>Valid data unit</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DUV_1</name>
                  <description>Data unit valid info.</description>
                  <lsb>25</lsb>
                  <msb>25</msb>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Invalid</name>
                      <description>Invalid data unit</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Valid</name>
                      <description>Valid data unit</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DUV_2</name>
                  <description>Data unit valid info.</description>
                  <lsb>26</lsb>
                  <msb>26</msb>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Invalid</name>
                      <description>Invalid data unit</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Valid</name>
                      <description>Valid data unit</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DUV_3</name>
                  <description>Data unit valid info.</description>
                  <lsb>27</lsb>
                  <msb>27</msb>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Invalid</name>
                      <description>Invalid data unit</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Valid</name>
                      <description>Valid data unit</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>D0</name>
                  <description>Dirty status of combined data unit 0 and 1.</description>
                  <lsb>28</lsb>
                  <msb>28</msb>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Clean</name>
                      <description>Clean data unit</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Dirty</name>
                      <description>Dirty data unit</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>D1</name>
                  <description>Dirty status of combined data unit 2 and 3.</description>
                  <lsb>29</lsb>
                  <msb>29</msb>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Clean</name>
                      <description>Clean data unit</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Dirty</name>
                      <description>Dirty data unit</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>V</name>
                  <description>Line valid bit.</description>
                  <lsb>30</lsb>
                  <msb>30</msb>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Invalid</name>
                      <description>Invalid cache line</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Valid</name>
                      <description>Valid cache line</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>MRU</name>
                  <description>Most recently used way.</description>
                  <lsb>31</lsb>
                  <msb>31</msb>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Way0</name>
                      <description>Way0 was most recently used</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Way1</name>
                      <description>Way1 was most recently used</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>UICR_NS</name>
      <description>User information configuration registers</description>
      <baseAddress>0x0FFF0000</baseAddress>
      <headerStructName>UICR</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>UICR</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>VERSION</name>
          <description>Version of the UICR format</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>MINOR</name>
              <description>Minor version</description>
              <lsb>0</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>MAJOR</name>
              <description>Major version</description>
              <lsb>16</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>LOCK</name>
          <description>Lock the UICR from modification</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <resetValue>0xBD2328A8</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PALL</name>
              <lsb>0</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Unlocked</name>
                  <description>UICR can be written, and is not integrity checked by Nordic IronSide SE</description>
                  <value>0xBD2328A8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Locked</name>
                  <description>UICR is read-only, and is integrity checked by Nordic IronSide SE on boot</description>
                  <value>0xFFFFFFFF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
          <name>APPROTECT</name>
          <description>Access Port protection settings for debug access control</description>
          <headerStructName>UICR_APPROTECT</headerStructName>
          <access>read-write</access>
          <addressOffset>0x010</addressOffset>
          <register>
            <name>APPLICATION</name>
            <description>APPLICATION access port protection</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0xBD2328A8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PALL</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Unprotected</name>
                    <description>Full debug access enabled through the access port</description>
                    <value>0xBD2328A8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile1</name>
                    <description>Reserved for future use</description>
                    <value>0x1730C77F</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile2</name>
                    <description>Reserved for future use</description>
                    <value>0xF05F1363</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile3</name>
                    <description>Reserved for future use</description>
                    <value>0x488C5ED6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile4</name>
                    <description>Reserved for future use</description>
                    <value>0x83C6B58D</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Protected</name>
                    <description>Debug access fully disabled through the access port</description>
                    <value>0xFFFFFFFF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>RADIOCORE</name>
            <description>RADIOCORE access port protection</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0xBD2328A8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PALL</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Unprotected</name>
                    <description>Full debug access enabled through the access port</description>
                    <value>0xBD2328A8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile1</name>
                    <description>Reserved for future use</description>
                    <value>0x1730C77F</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile2</name>
                    <description>Reserved for future use</description>
                    <value>0xF05F1363</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile3</name>
                    <description>Reserved for future use</description>
                    <value>0x488C5ED6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile4</name>
                    <description>Reserved for future use</description>
                    <value>0x83C6B58D</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Protected</name>
                    <description>Debug access fully disabled through the access port</description>
                    <value>0xFFFFFFFF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CORESIGHT</name>
            <description>CoreSight access port protection</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-write</access>
            <resetValue>0xBD2328A8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PALL</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Unprotected</name>
                    <description>Full debug access enabled through the access port</description>
                    <value>0xBD2328A8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile1</name>
                    <description>Reserved for future use</description>
                    <value>0x1730C77F</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile2</name>
                    <description>Reserved for future use</description>
                    <value>0xF05F1363</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile3</name>
                    <description>Reserved for future use</description>
                    <value>0x488C5ED6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Profile4</name>
                    <description>Reserved for future use</description>
                    <value>0x83C6B58D</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Protected</name>
                    <description>Debug access fully disabled through the access port</description>
                    <value>0xFFFFFFFF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <register>
          <name>ERASEPROTECT</name>
          <description>Erase protection</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <resetValue>0xBD2328A8</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PALL</name>
              <lsb>0</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Unprotected</name>
                  <description>ERASEALL operation is allowed</description>
                  <value>0xBD2328A8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Protected</name>
                  <description>ERASEALL operation is blocked</description>
                  <value>0xFFFFFFFF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
          <name>PROTECTEDMEM</name>
          <description>Protected Memory region configuration for integrity-checked immutable bootloaders and data</description>
          <headerStructName>UICR_PROTECTEDMEM</headerStructName>
          <access>read-write</access>
          <addressOffset>0x024</addressOffset>
          <register>
            <name>ENABLE</name>
            <description>Enable the Protected Memory region</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0xBD2328A8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ENABLE</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Protected Memory region is disabled, no integrity checking</description>
                    <value>0xBD2328A8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Protected Memory region is enabled and integrity checked by IronSide SE</description>
                    <value>0xFFFFFFFF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>SIZE4KB</name>
            <description>Protected Memory region size in 4 kiB blocks.</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0xBD2328A8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SIZE4KB</name>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>WDTSTART</name>
          <description>Start a local watchdog timer ahead of the CPU boot.</description>
          <headerStructName>UICR_WDTSTART</headerStructName>
          <access>read-write</access>
          <addressOffset>0x02C</addressOffset>
          <register>
            <name>ENABLE</name>
            <description>Enable watchdog timer start.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0xBD2328A8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ENABLE</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Watchdog timer is not started automatically</description>
                    <value>0xBD2328A8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Watchdog timer is started automatically ahead of CPU boot</description>
                    <value>0xFFFFFFFF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>INSTANCE</name>
            <description>Watchdog timer instance.</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0xBD2328A8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>INSTANCE</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>WDT0</name>
                    <description>Use WDT0 instance</description>
                    <value>0xBD2328A8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WDT1</name>
                    <description>Use WDT1 instance</description>
                    <value>0x1730C77F</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CRV</name>
            <description>Initial CRV (Counter Reload Value) register value.</description>
            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <resetValue>0xBD2328A8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CRV</name>
                <description>Initial CRV value for the WDT</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>SECURESTORAGE</name>
          <description>Secure Storage configuration</description>
          <headerStructName>UICR_SECURESTORAGE</headerStructName>
          <access>read-write</access>
          <addressOffset>0x03C</addressOffset>
          <register>
            <name>ENABLE</name>
            <description>Enable the Secure Storage</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0xBD2328A8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ENABLE</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Secure Storage is disabled</description>
                    <value>0xBD2328A8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Secure Storage is enabled and configured</description>
                    <value>0xFFFFFFFF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>ADDRESS</name>
