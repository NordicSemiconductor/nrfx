                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NotSet</name>
                    <description>Secure access bit was not set</description>
                    <value>0x0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>ERRORSOURCE</name>
                <description>Source of memory access error</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MPC</name>
                    <description>Error was triggered by MPC module</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Slave</name>
                    <description>Error was triggered by an AXI slave</description>
                    <value>0x0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
