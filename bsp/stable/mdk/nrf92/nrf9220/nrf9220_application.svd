                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>STSAHBHTRANS</name>
                <description>The value of AHB master htrans output. Must trigger read_sts_bits to update this field.</description>
                <lsb>14</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>STSCNTRFREE</name>
