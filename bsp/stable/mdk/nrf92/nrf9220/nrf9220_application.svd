          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PATTCOUNT</name>
              <description>8-bit counter value to indicate the number of traceclkin cycles for which a pattern runs before it switches to the next pattern.</description>
