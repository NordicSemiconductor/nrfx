                <enumeratedValue>
                  <name>Grouped</name>
                  <description>1st half word (16-bit) used in channel 0..1; 2nd word in channel 2..3</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Individual</name>
