                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Internal</name>
                    <description>Power rail is configured to use the internal regulator. This option requires the presence of an inductor for the 1V8 DCDC regulator.</description>
