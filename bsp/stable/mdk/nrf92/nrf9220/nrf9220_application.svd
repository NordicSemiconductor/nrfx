                </enumeratedValue>
                <enumeratedValue>
                  <name>True</name>
                  <description>Process counter value comparisons supported.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STATUS</name>
